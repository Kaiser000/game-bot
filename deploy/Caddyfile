{$PUBLIC_DOMAIN:localhost} {
  encode zstd gzip

  handle /api/* {
    reverse_proxy backend:8000
  }

  handle {
    root * /srv/frontend
    try_files {path} /index.html
    file_server
  }

  header {
    X-Content-Type-Options nosniff
    X-Frame-Options DENY
    Referrer-Policy no-referrer
  }
}
